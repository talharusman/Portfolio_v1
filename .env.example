# Contact form (src/lib/contact.ts). The form shows an honest "not set up" state until both are set.
# Copy to .env.local for development, or set these in your hosting provider.

# API key from https://resend.com (never commit the real value)
RESEND_API_KEY=
# Address that receives the messages
CONTACT_TO_EMAIL=
# Optional sender. The default only delivers to the Resend account owner until a domain is verified.
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# Public origin of the deployed site, used for canonical URLs, the sitemap and social previews.
# Example: https://yourdomain.com  (no trailing slash). Falls back to http://localhost:3000.
SITE_URL=

